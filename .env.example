# Plantilla de entorno. Copiala a `.env` y completala.
# `.env` esta ignorado por git y nunca se commitea.

# ── Base de datos ───────────────────────────────────────────────────
# Postgres 17. Para desarrollo local, `npm run db:local` levanta uno en
# el puerto 5434 y te imprime esta cadena al terminar.
DATABASE_URL=

# Tamano maximo del pool de conexiones. Por defecto 10.
PGPOOL_MAX=

# ── Autenticacion (GoTrue) ──────────────────────────────────────────
# GoTrue standalone, no Supabase completo. La app le hace de proxy en
# /auth/v1, asi que esta URL es la interna del servicio.
GOTRUE_URL=

# Clave anonima que el navegador usa contra GoTrue. Se hornea en el
# bundle del cliente en tiempo de build: cambiarla exige rebuild.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opcional. Sin esto el navegador usa su propio origen, que es lo que
# mantiene la imagen desatada de cualquier dominio. Dejala vacia salvo
# que sepas por que la necesitas.
NEXT_PUBLIC_SUPABASE_URL=

# Opcional. URL interna para las llamadas del lado del servidor.
SUPABASE_INTERNAL_URL=

# ── Proveedor de datos (Apify) ──────────────────────────────────────
# Token de respaldo: se usa solo cuando el usuario no cargo el suyo en
# Configuracion. En produccion conviene que cada usuario ponga el propio.
APIFY_TOKEN=

# Opcional. Solo para apuntar a un doble local en los tests. En
# desarrollo y produccion va vacia.
APIFY_API_BASE_URL=

# ── Procesamiento externo ───────────────────────────────────────────
# Estas dos apuntan a flujos que hoy viven fuera del repositorio.
# Sin ellas, el analisis de aperturas y el chat de agentes devuelven
# error. Ver el issue #10.
N8N_ANALYSIS_WEBHOOK_URL=
N8N_AI_CHAT_WEBHOOK_URL=
